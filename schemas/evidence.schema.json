{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Hmoute-Oussama/VERITY/main/schemas/evidence.schema.json",
  "title": "VERITY evidence v1",
  "type": "object",
  "required": ["id", "claim_id", "verifier", "status", "valid", "superseded", "summary", "details", "payload", "confidence", "commit_sha", "created_at", "checked_at"],
  "properties": {
    "id": {"type": "string"},
    "claim_id": {"type": "string"},
    "verifier": {"type": "string"},
    "status": {"type": "string", "enum": ["pass", "warn", "fail", "error", "stale"]},
    "valid": {"type": "boolean"},
    "superseded": {"type": "boolean"},
    "summary": {"type": "string"},
    "details": {"type": "string"},
    "payload": {"type": "object"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "commit_sha": {"type": ["string", "null"]},
    "created_at": {"type": "string"},
    "checked_at": {"type": "string"},
    "invalidated_reason": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
